# Python NLP/ML service environment variables (copy to .env)

ML_SERVICE_PORT=8000

# Shared key the Node.js backend must present (protected internal API,
# SRS 6.2). Must match backend ML_SERVICE_API_KEY.
ML_SERVICE_API_KEY=replace_with_internal_service_key

# Identifier of the trained model artifact in app/models/artifacts,
# stored on every AnalysisResult for traceability (SDD 5.1).
MODEL_VERSION=v1.0.0
